# Copy to .env and adjust. Used when running the app on the host (e.g. python web_app.py).

# Neo4j (default: bolt://localhost:7687). If Docker uses alternate ports (e.g. 17687) due to Windows port reservation, set:
# NEO4J_URI=bolt://localhost:17687
# Neo4j Browser then: http://localhost:17474
# NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=lng-graphrag-password

# MySQL (defaults match docker-compose.yml)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=lng_user
# MYSQL_PASSWORD=lng-graphrag-password
# MYSQL_DATABASE=lng_graphrag_auth
